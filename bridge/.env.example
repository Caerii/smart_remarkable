# Tablet-facing credential. Generate independently; never reuse the OpenClaw
# Gateway token. Use 43-128 base64url characters. The default mode-0600 file is
# ~/.config/smart-remarkable-openclaw-bridge/tablet.token.
# SMART_REMARKABLE_BRIDGE_TOKEN_FILE=/absolute/override/path
# SMART_REMARKABLE_BRIDGE_TOKEN=

# By default, the full Gateway token and direct WhatsApp route are read from:
#   ~/.openclaw/openclaw.json -> gateway.auth.token
#   ~/.openclaw/agents/main/sessions/sessions.json
#     -> ["agent:main:main"].origin.{provider,chatType,to,accountId}
# The origin must be a direct WhatsApp conversation and cannot be overridden.
# The full Gateway token may optionally be supplied by the server environment:
# OPENCLAW_GATEWAY_TOKEN=

# Optional path overrides for a nonstandard OpenClaw home.
# OPENCLAW_CONFIG_PATH=
# OPENCLAW_SESSIONS_PATH=

# Loopback-only defaults.
SMART_REMARKABLE_BRIDGE_HOST=127.0.0.1
SMART_REMARKABLE_BRIDGE_PORT=18792
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Persistent request idempotency journal. A custom path must be absolute and
# end in /request-journal-v1. For the production systemd system service, use its
# private StateDirectory as shown in
# systemd/smart-remarkable-openclaw-bridge.service.example; do not make the
# user's whole home writable. Manual runs default to:
#   $OPENCLAW_HOME/smart-remarkable-bridge/request-journal-v1
# The journal never auto-evicts; when its fixed capacity is reached, new
# requests fail closed until an operator performs explicit maintenance.
# SMART_REMARKABLE_REQUEST_JOURNAL_DIR=/absolute/dedicated/request-journal-v1
SMART_REMARKABLE_REQUEST_JOURNAL_MAX_ENTRIES=20000

# Optional timeout tuning.
SMART_REMARKABLE_RUN_TIMEOUT_MS=180000
SMART_REMARKABLE_GATEWAY_CONNECT_TIMEOUT_MS=15000
SMART_REMARKABLE_SEND_TIMEOUT_MS=15000
